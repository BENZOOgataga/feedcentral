# =============================================================================
# FeedCentral Environment Configuration
# =============================================================================
# This file shows all environment variables used by the application.
# Copy this to .env and fill in your values for local development.
# For production (Vercel), set these in the Vercel dashboard.

# =============================================================================
# DATABASE
# =============================================================================
# Priority: PRISMA_DATABASE_URL → POSTGRES_URL → DATABASE_URL

# Local Development: Use DATABASE_URL
DATABASE_URL="postgresql://user:password@localhost:5432/feedcentral"

# Vercel Production: These are auto-injected by Vercel Postgres
# PRISMA_DATABASE_URL="postgres://...?pgbouncer=true"  (pooled connection)
# POSTGRES_URL="postgres://..."                        (direct connection)

# =============================================================================
# AUTHENTICATION
# =============================================================================
# JWT secret for signing tokens (REQUIRED)
# Must be at least 32 characters long
# Generate with: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

JWT_SECRET="your-secret-key-here-min-32-chars-generate-with-openssl"

# =============================================================================
# ADMIN CREDENTIALS
# =============================================================================
# Option 1: Provide plain password (will be hashed during seeding)
ADMIN_USERNAME="admin@feedcentral.local"
ADMIN_PASSWORD="admin123"

# Option 2: Provide pre-hashed password (for production)
# Generate with: node -e "const bcrypt = require('bcryptjs'); console.log(bcrypt.hashSync('your-password', 10))"
# ADMIN_PASSWORD_HASH="$2a$10$..."

# Note: If both ADMIN_PASSWORD and ADMIN_PASSWORD_HASH are set, 
# ADMIN_PASSWORD_HASH takes priority

# =============================================================================
# SECURITY
# =============================================================================
# API key for securing cron endpoints (recommended for production)
# Generate with: openssl rand -hex 32

# CRON_API_KEY="your-cron-secret-key"

# CORS origin for API requests (optional, defaults to same-origin)
# CORS_ORIGIN="https://yourdomain.com"

# =============================================================================
# SITE CONFIGURATION
# =============================================================================
# Public site URL - auto-detected on Vercel
# Vercel automatically provides: VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL
# Only set manually if you need to override

# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# =============================================================================
# NOTES
# =============================================================================
# Local Development (.env file):
#   - DATABASE_URL (required)
#   - JWT_SECRET (required)
#   - LICENSE_SIGNING_SECRET (required for license system)
#   - ADMIN_USERNAME, ADMIN_PASSWORD (optional, defaults shown above)
#
# Production (Vercel Dashboard):
#   - PRISMA_DATABASE_URL (auto-injected by Vercel Postgres)
#   - POSTGRES_URL (auto-injected by Vercel Postgres)
#   - JWT_SECRET (set manually)
#   - LICENSE_SIGNING_SECRET (required for license system, generate unique per instance)
#   - ADMIN_USERNAME (optional override)
#   - ADMIN_PASSWORD_HASH (recommended) or ADMIN_PASSWORD
#   - CRON_API_KEY (recommended)
#   - CORS_ORIGIN (optional)
#   - NEXT_PUBLIC_SITE_URL (optional, auto-detected)

# =============================================================================
# IMAGE PROXY / CACHING / SECURITY
# =============================================================================
# Image proxy: service that sanitizes remote images before serving them same-origin.
# Tweak these values in production to tune timeouts, size limits and trusted hosts.
# Do NOT commit production secrets to source control. Add them to your Vercel project.

# Comma-separated list of hostnames allowed by the image proxy (exact or suffix matches)
# Example: "images.unsplash.com,cdn.example-cdn.com,platform.theverge.com"
IMAGE_PROXY_ALLOWED_HOSTS="images.unsplash.com,platform.theverge.com,cdn.vox-cdn.com"

# Maximum allowed bytes to fetch from remote images (default: 1MB)
IMAGE_PROXY_MAX_BYTES=1048576

# Timeout for remote image fetch in milliseconds (default: 5000)
IMAGE_PROXY_TIMEOUT_MS=5000

# Cache control for proxied images (short TTL recommended)
IMAGE_PROXY_CACHE_MAX_AGE=60
IMAGE_PROXY_CACHE_SMAX=300

# Server-side image cache TTL (seconds) used by in-process cache (default: 300)
IMAGE_CACHE_TTL_SEC=300

# API caching: default TTL (seconds) for endpoints like /api/articles
API_CACHE_TTL_SEC=60

# Allow bypassing server cache via header/query param (only enable intentionally)
# In production set to '0' to disallow bypass. In development it may default to enabled.
API_ALLOW_CACHE_BYPASS=0

# Client-side allowlist for direct image fallbacks (NEXT_PUBLIC_* is exposed to client)
# Comma-separated list, used by UI to decide if a remote URL may be used directly
NEXT_PUBLIC_ALLOWED_IMAGE_HOSTS="images.unsplash.com,platform.theverge.com"

# RSS allowed CIDRs (comma-separated) for SSRF exceptions, optional but recommended
# Example: "76.76.21.0/24,99.83.64.0/18"
RSS_ALLOWED_CIDRS=""

# CRON secret used by Vercel Cron (if you configure a Vercel Cron job to call your
# API, set the Authorization header to: Bearer <CRON_SECRET> or use CRON_API_KEY)
CRON_SECRET=""
